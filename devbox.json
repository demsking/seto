{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.5/.schema/devbox.schema.json",
  "packages": [
    "python@3.12",
    "poetry@latest",
    "tmux@latest",
    "gitmux@latest",
    "git-secret@latest",
    "tmuxinator@latest",
    "gnumake@latest",
    "pre-commit@latest",
    "editorconfig-checker@latest",
    "python312Packages.autopep8@latest",
    "python312Packages.bandit@latest",
    "python312Packages.pylint@latest",
    "python312Packages.twine@latest",
    "python312Packages.pyyaml@latest",
    "hadolint@latest",
    "ruff@latest",
    "python312Packages.pyaml@latest"
  ],
  "env": {
    "VENV_DIR": ".venv",
    "PYTHONPATH": ".:$VENV_DIR/lib/python3.12/site-packages:$PYTHONPATH",
    "PATH": "$VENV_DIR/bin:$PATH"
  },
  "shell": {
    "init_hook": ["pre-commit install -f"],
    "scripts": {}
  }
}
